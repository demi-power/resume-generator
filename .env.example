# Next.js backend / unified pipeline

# Core app auth and server helpers
JWT_SECRET=replace-me
PDF_BASE_URL=http://127.0.0.1:3000
CRON_SECRET=replace-me

# Optional DeepSeek settings for the existing desktop/webview generation path
